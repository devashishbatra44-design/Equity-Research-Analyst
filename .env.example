# Copy these names into your local .env and fill only what your code needs.
# Never put a real key in this template or commit .env.
API_KEY=paste-here
SEC_USER_AGENT="Your Name your@purdue.edu"

# Purdue GenAI Studio uses the same secret through this provider-specific name.
GENAI_API_KEY=paste-here
GENAI_BASE_URL=https://genai.rcac.purdue.edu/api
GENAI_MODEL=paste-model-name-here

# Financial Datasets API (data provider; sent as X-API-KEY)
FINANCIAL_DATASETS_API_KEY=paste-here

# Tavily Search API. Optional: the desk can use Tavily's rate-limited keyless mode.
TAVILY_API_KEY=paste-here
